# MODELLO per il repository SEPARATO `tva-live-scheduler` (da copiare in .github/workflows/live-scheduler.yml di QUEL repository).
# NON e un workflow di marvel-timeline: qui e solo un file di esempio. Non attivo finche non crei il repository e il secret.
# Il cron funziona perche questo repository ha main come branch predefinito (i cron girano solo sul branch predefinito).
name: TVA Live - scheduler giornaliero
on:
  schedule:
    - cron: '17 5 * * *'      # una volta al giorno, minuto non tondo (evita i picchi di carico di GitHub). UTC.
  workflow_dispatch:
permissions:
  contents: write              # solo per il keepalive mensile di QUESTO repository (evita la disattivazione dopo 60 giorni di inattivita)
concurrency:
  group: tva-live-scheduler
  cancel-in-progress: false
jobs:
  dispatch:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - name: Avvia l aggiornamento del catalogo sul branch TEST e attendi l esito
        env:
          GH_TOKEN: ${{ secrets.TVA_DISPATCH_TOKEN }}    # token fine-grained: solo marvel-timeline, solo Actions: Read and write
        run: |
          set -euo pipefail
          REPO="Posty2001/marvel-timeline"
          started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          gh workflow run tmdb-sync.yml -R "$REPO" --ref test/tva-archives -f solo_live_build=true -f live_commit=true
          id=""
          for i in $(seq 1 12); do
            id="$(gh run list -R "$REPO" -w tmdb-sync.yml --branch test/tva-archives --event workflow_dispatch --created ">=$started" --limit 1 --json databaseId -q '.[0].databaseId' || true)"
            [ -n "$id" ] && break
            sleep 10
          done
          [ -n "$id" ] || { echo "::error::Run di aggiornamento non trovato"; exit 1; }
          gh run watch "$id" -R "$REPO" --exit-status      # rosso se l aggiornamento e stato rifiutato o e fallito => email di GitHub
      - name: Keepalive mensile (solo questo repository)
        if: ${{ github.event_name == 'schedule' }}
        run: |
          if [ "$(date -u +%d)" = "01" ]; then
            date -u +%Y-%m-%d > .keepalive
            git config user.name "tva-live-bot"; git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
            git add .keepalive && (git diff --cached --quiet || git commit -q -m "keepalive" && git push -q)
          fi
